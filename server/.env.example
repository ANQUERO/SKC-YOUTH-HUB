# Use DATABASE_URL for a managed/cloud PostgreSQL database. For local
# PostgreSQL, leave it unset and configure the DB_* variables below.
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

DB_HOST=localhost
DB_PORT=5432
DB_NAME=skc
DB_USER=postgres
DB_PASSWORD=replace_with_your_postgres_password

JWT_SECRET=replace_with_a_long_random_secret

PORT=4521
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Required by the forgot-password email flow.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=replace_with_an_app_password

# Required for profile pictures, attachments, and post media.
CLOUDINARY_CLOUD_NAME=replace_with_your_cloud_name
CLOUDINARY_API_KEY=replace_with_your_api_key
CLOUDINARY_API_SECRET=replace_with_your_api_secret
